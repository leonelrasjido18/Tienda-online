// Fase 0: autenticación de staff y auditoría.
// Fase 1: catálogo deportivo (ligas, equipos, temporadas, productos, variantes, stock).
// Ventas, personalización e importación se agregan en fases siguientes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  STAFF
}

model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         StaffRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("staff_users")
}

model RefreshToken {
  id              String    @id @default(uuid())
  staffUserId     String
  staffUser       StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?
  createdByIp     String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([staffUserId])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String     @id @default(uuid())
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catálogo (Fase 1)
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FulfillmentMode {
  IN_STOCK
  PREORDER
  BOTH
}

enum StockMovementType {
  SALE
  RETURN
  ADJUSTMENT
  RECEIPT
}

model League {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams        Team[]
  products     Product[]
  sizeGuides   SizeGuide[]
  fonts        LeagueFont[]
  patchLeagues PatchLeague[]

  @@map("leagues")
}

model Team {
  id        String   @id @default(uuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  name      String
  slug      String   @unique
  crestUrl  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([leagueId])
  @@map("teams")
}

model Season {
  id        String   @id @default(uuid())
  label     String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@map("seasons")
}

model Category {
  id        String     @id @default(uuid())
  parentId  String?
  parent    Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToParent")
  name      String
  slug      String     @unique
  imageUrl  String?
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products   Product[]
  sizeGuides SizeGuide[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]

  @@map("collections")
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model SizeGuide {
  id          String    @id @default(uuid())
  name        String
  leagueId    String?
  league      League?   @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contentHtml String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("size_guides")
}

model Product {
  id               String          @id @default(uuid())
  slug             String          @unique
  name             String
  description      String?         @db.Text
  status           ProductStatus   @default(DRAFT)
  fulfillmentMode  FulfillmentMode @default(IN_STOCK)
  preorderLeadDays Int?

  brandId     String?
  brand       Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  leagueId    String?
  league      League?    @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  teamId      String?
  team        Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  seasonId    String?
  season      Season?    @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  sizeGuideId String?
  sizeGuide   SizeGuide? @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?

  position    Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  options       ProductOption[]
  variants      ProductVariant[]
  images        ProductImage[]
  collections   ProductCollection[]
  customization CustomizationTemplate?
  reviews       Review[]

  @@index([status])
  @@index([leagueId])
  @@index([teamId])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductOption {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int     @default(0)

  values ProductOptionValue[]

  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id       String        @id @default(uuid())
  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  position Int           @default(0)

  variantLinks VariantOptionValue[]
  images       ProductImage[]

  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id                  String   @id @default(uuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String   @unique
  priceCents          Int
  compareAtPriceCents Int?
  costCents           Int?
  weightGrams         Int?
  barcode             String?
  position            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  optionValues VariantOptionValue[]
  inventory    InventoryItem?
  movements    StockMovement[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId String
  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  valueId   String
  value     ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@map("variant_option_values")
}

model ProductImage {
  id            String              @id @default(uuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValueId String?
  optionValue   ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)
  url           String
  alt           String?
  position      Int                 @default(0)
  createdAt     DateTime            @default(now())

  customizationTemplates CustomizationTemplate[]

  @@index([productId])
  @@index([optionValueId])
  @@map("product_images")
}

model InventoryItem {
  id               String         @id @default(uuid())
  variantId        String         @unique
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity         Int            @default(0)
  reserved         Int            @default(0)
  trackInventory   Boolean        @default(true)
  allowPreorder    Boolean        @default(false)
  preorderLeadDays Int?
  updatedAt        DateTime       @updatedAt

  @@map("inventory_items")
}

model StockMovement {
  id        String            @id @default(uuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())

  @@index([variantId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Personalización (Fase 2)
// ---------------------------------------------------------------------------

model LeagueFont {
  id              String   @id @default(uuid())
  leagueId        String
  league          League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name            String
  fontFileUrl     String
  fillColor       String   @default("#FFFFFF")
  strokeColor     String?
  strokeWidthPx   Int      @default(0)
  letterSpacingPx Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  templates CustomizationTemplate[]

  @@index([leagueId])
  @@map("league_fonts")
}

model Patch {
  id         String   @id @default(uuid())
  name       String
  imageUrl   String
  priceCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leagues  PatchLeague[]
  products ProductCustomizationOption[]

  @@map("patches")
}

model PatchLeague {
  patchId  String
  patch    Patch  @relation(fields: [patchId], references: [id], onDelete: Cascade)
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([patchId, leagueId])
  @@map("patch_leagues")
}

model CustomizationTemplate {
  id                   String        @id @default(uuid())
  productId            String        @unique
  product              Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  enableName           Boolean       @default(true)
  enableNumber         Boolean       @default(true)
  enablePatches        Boolean       @default(false)
  maxNameLength        Int           @default(12)
  minNumber            Int           @default(1)
  maxNumber            Int           @default(99)
  nameExtraCents       Int           @default(0)
  numberExtraCents     Int           @default(0)
  fontId               String?
  font                 LeagueFont?   @relation(fields: [fontId], references: [id], onDelete: SetNull)
  // Estilo por producto: los colores/contorno viven acá y no en la fuente, porque
  // el mismo tipo de letra (bloque, retro…) aparece en camisetas con colores muy
  // distintos. El analizador de IA los completa leyendo la foto modelo.
  fillColor            String        @default("#FFFFFF")
  strokeColor          String?
  strokeWidthPx        Int           @default(0)
  letterSpacingPx      Int           @default(0)
  customizationImageId String?
  customizationImage   ProductImage? @relation(fields: [customizationImageId], references: [id], onDelete: SetNull)
  namePrintArea        Json
  numberPrintArea      Json
  patchPrintArea       Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  patchOptions ProductCustomizationOption[]

  @@map("customization_templates")
}

model ProductCustomizationOption {
  id         String                @id @default(uuid())
  templateId String
  template   CustomizationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  patchId    String
  patch      Patch                 @relation(fields: [patchId], references: [id], onDelete: Cascade)

  @@unique([templateId, patchId])
  @@map("product_customization_options")
}

// ---------------------------------------------------------------------------
// Ventas: carrito, checkout, pagos en dos etapas (Fase 3)
// ---------------------------------------------------------------------------

enum PaymentPlan {
  FULL
  DEPOSIT_BALANCE
}

enum OrderFinancialStatus {
  PENDING
  DEPOSIT_PAID
  AWAITING_BALANCE
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  EXPIRED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  AWAITING_IMPORT
  READY
  FULFILLED
  CANCELLED
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
  REFUND
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

model Customer {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  phone     String?
  // Autenticación por contraseña. `passwordHash` es opcional para no romper filas
  // creadas antes (cuentas sin clave); el login exige que esté seteado.
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Default shipping details
  defaultPickupInStore Boolean @default(false)
  defaultStreet        String?
  defaultNumber        String?
  defaultFloor         String?
  defaultCity          String?
  defaultProvince      String?
  defaultPostalCode    String?
  defaultNotes         String?

  // Referral details
  referralCode         String?   @unique
  referredById         String?
  referredBy           Customer? @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            Customer[] @relation("Referrals")
  referralBalanceCents Int       @default(0)

  carts                Cart[]
  orders               Order[]
  couponUses           CouponCustomerUse[]
  referralRewardsGiven    ReferralReward[] @relation("Referred")
  referralRewardsReceived ReferralReward[] @relation("Referrer")
  reviews              Review[]

  @@map("customers")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Reseña de producto. Sólo la puede dejar un cliente con un pedido PAID que
 * incluyó ese producto (comprador verificado), una por producto, y entra como
 * PENDING hasta que el panel la modera.
 */
model Review {
  id         String       @id @default(uuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String
  rating     Int
  title      String?
  body       String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

/**
 * Códigos de un solo uso para verificar el email y para restablecer la contraseña.
 * (Antes se usaba para login sin clave; ahora el login es por contraseña.)
 */
model CustomerAuthCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      String   @default("VERIFY_EMAIL") // VERIFY_EMAIL | RESET_PASSWORD
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([email, type])
  @@map("customer_magic_codes")
}

model StaticPage {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  contentHtml String   @db.Text
  contentMd   String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("static_pages")
}

model FAQ {
  id         String   @id @default(uuid())
  question   String
  answerHtml String   @db.Text
  answerMd   String?  @db.Text
  category   String
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("faqs")
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id               String     @id @default(uuid())
  code             String     @unique
  type             CouponType
  value            Int
  minPurchaseCents Int        @default(0)
  maxUses          Int?
  uses             Int        @default(0)
  expiresAt        DateTime?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  orders       Order[]
  customerUses CouponCustomerUse[]

  @@map("coupons")
}

model CouponCustomerUse {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  createdAt  DateTime @default(now())

  @@unique([couponId, customerId, orderId])
  @@map("coupon_customer_uses")
}

model ReferralReward {
  id          String   @id @default(uuid())
  referrerId  String
  referrer    Customer @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String   @unique
  referred    Customer @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  rewardCents Int
  status      String   @default("PENDING") // PENDING, APPROVED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("referral_rewards")
}

model Cart {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime

  // Recuperación de carrito abandonado: hasta qué etapa (0=ninguna, 1=4h, 2=24h,
  // 3=72h) se avisó. Se reinicia a 0 cuando el cliente vuelve a tocar el carrito.
  abandonedStage         Int       @default(0)
  lastAbandonedReminderAt DateTime?

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                 String         @id @default(uuid())
  cartId             String
  cart               Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity           Int
  priceCentsAtAdd    Int
  customizationDraft Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id     String @id @default(uuid())
  number Int    @unique @default(autoincrement())
  /// Token público de alta entropía. Nunca se exponen los UUID internos al cliente.
  publicToken String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  couponId      String?
  coupon        Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountCents Int                    @default(0)

  contactName  String
  contactEmail String
  contactPhone String?

  pickupInStore      Boolean @default(false)
  shippingStreet     String?
  shippingNumber     String?
  shippingFloor      String?
  shippingCity       String?
  shippingProvince   String?
  shippingPostalCode String?
  shippingNotes      String?

  paymentPlan       PaymentPlan            @default(FULL)
  financialStatus   OrderFinancialStatus   @default(PENDING)
  fulfillmentStatus OrderFulfillmentStatus @default(UNFULFILLED)

  subtotalCents Int
  depositCents  Int?
  balanceCents  Int?
  shippingCents Int?
  totalCents    Int

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  notes     String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items        OrderItem[]
  events       OrderEvent[]
  payments     Payment[]
  paymentLinks PaymentLink[]
  shipment     Shipment?

  @@index([financialStatus])
  @@index([customerId])
  @@index([importBatchId])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName  String
  variantSku   String
  optionsLabel String?
  imageUrl     String?

  unitPriceCents  Int
  quantity        Int
  totalCents      Int
  fulfillmentMode FulfillmentMode

  customization OrderItemCustomization?

  @@index([orderId])
  @@map("order_items")
}

model OrderItemCustomization {
  id          String    @id @default(uuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  playerName         String?
  playerNumber       Int?
  fontId             String?
  patchIds           Json
  extraCents         Int
  previewImageUrl    String?
  productionImageUrl String?

  @@map("order_item_customizations")
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_events")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind              PaymentKind
  provider          String
  providerPaymentId String?
  amountCents       Int
  status            PaymentStatus @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model StoreSettings {
  id                       Int      @id @default(1)
  defaultDepositPercent    Int      @default(50)
  bankTransferInstructions String?  @db.Text
  whatsappPhone            String?
  whatsappMessage          String?
  instagramUser            String?
  contactEmail             String?
  pickupAddress            String?  @db.Text
  openingHours             String?

  // Métodos de cobro que ofrece la tienda (se togglean desde Ajustes → Cobros).
  enableBankTransfer       Boolean  @default(true)
  enableCardPayment        Boolean  @default(true)
  enableCash               Boolean  @default(false)
  updatedAt                DateTime @updatedAt

  @@map("store_settings")
}

model PushSubscription {
  id         String   @id @default(uuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Importación y cobro del saldo (Fase 4)
// ---------------------------------------------------------------------------

enum ImportBatchStatus {
  OPEN
  ORDERED
  IN_TRANSIT
  CUSTOMS
  RECEIVED
  CLOSED
}

/// Lote de importación: agrupa los pedidos por encargo que viajan juntos desde China.
model ImportBatch {
  id       String            @id @default(uuid())
  code     String            @unique
  supplier String?
  status   ImportBatchStatus @default(OPEN)

  /// Fecha tope para sumar pedidos nuevos a este lote (la cuenta regresiva pública).
  closesAt    DateTime?
  /// Llegada estimada. Se comunica al cliente como rango, nunca como fecha exacta.
  etaDate     DateTime?
  trackingRef String?

  /// Ventana de encargo pública: sólo una puede estar activa a la vez. Mientras lo
  /// esté (y closesAt sea futuro), la tienda muestra la cuenta regresiva y los
  /// pedidos por encargo se suman solos a este lote.
  isActive Boolean @default(false)
  /// Días de llegada prometidos, contados desde el cierre de la ventana (ej. 20).
  promisedDeliveryDays Int?
  /// Cupo mínimo de unidades para disparar el pedido (sólo visible en el panel).
  minUnits Int @default(12)

  /// Costos de importación del lote completo, para calcular rentabilidad.
  freightCents  Int?
  customsCents  Int?
  otherfeeCents Int?

  notes      String?   @db.Text
  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orders Order[]
  events ImportBatchEvent[]

  @@index([status])
  @@map("import_batches")
}

model ImportBatchEvent {
  id        String      @id @default(uuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type      String
  message   String?
  createdAt DateTime    @default(now())

  @@index([batchId])
  @@map("import_batch_events")
}

enum PaymentLinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

/// Link de cobro del saldo. El cliente entra con el token, ve su pedido y paga
/// saldo + envío. Se genera automáticamente al marcar el lote como RECEIVED.
model PaymentLink {
  id      String @id @default(uuid())
  /// Token público, va en la URL. Se busca por acá, nunca por id.
  token   String @unique
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Desglose congelado al momento de generar el link.
  balanceCents  Int
  shippingCents Int
  amountCents   Int

  status    PaymentLinkStatus @default(PENDING)
  expiresAt DateTime

  /// Preferencia de Mercado Pago asociada, para reusarla si el cliente vuelve.
  providerPreferenceId String?

  /// Control de recordatorios: cuántos se mandaron y cuándo fue el último.
  remindersSent  Int       @default(0)
  lastRemindedAt DateTime?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("payment_links")
}

/// Tarifa de envío manual por provincia. Es el fallback que funciona sin depender
/// de ninguna API externa; el proveedor de Andreani se enchufa detrás de la misma
/// interfaz ShippingProvider cuando haya credenciales.
model ShippingRate {
  id         String  @id @default(uuid())
  /// Nombre de provincia tal como se guarda en Order.shippingProvince.
  province   String  @unique
  /// Costo base del envío a esa provincia.
  priceCents Int
  /// Días hábiles estimados de entrega, para comunicarle al cliente.
  etaDays    Int?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipping_rates")
}

model Shipment {
  id             String    @id @default(uuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String
  trackingNumber String
  labelUrl       String?
  status         String    @default("PREPARING")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("shipments")
}
