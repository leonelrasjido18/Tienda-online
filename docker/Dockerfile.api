# API NestJS — imagen de producción. Contexto de build = raíz del monorepo.
FROM node:22-bookworm-slim AS base
# openssl lo necesita el motor de Prisma; ca-certificates para llamadas HTTPS salientes.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# --- build ---
FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @tienda/shared build
RUN pnpm --filter api exec prisma generate
RUN pnpm --filter api build

# --- runtime ---
FROM base AS runtime
ENV NODE_ENV=production
# Se copia el árbol ya instalado y compilado. El entrypoint es dist/main.js
# (tsconfig.build acota la salida para que NO quede en dist/src/).
COPY --from=build /app /app
WORKDIR /app/apps/api
EXPOSE 3001
# migrate deploy asegura el schema antes de arrancar; idempotente si ya está al día.
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/main.js"]
