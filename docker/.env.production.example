# ─── Producción — copiar a .env.production y completar ────────────────────────
# Ejecutar el compose con:  docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

NODE_ENV=production
PORT=3001

# ─── Base de datos y Redis (hostnames internos del compose) ───────────────────
POSTGRES_USER=tienda
POSTGRES_PASSWORD=CAMBIAR_por_una_clave_larga_y_aleatoria
POSTGRES_DB=tienda_online
DATABASE_URL=postgresql://tienda:CAMBIAR_por_una_clave_larga_y_aleatoria@postgres:5432/tienda_online
REDIS_URL=redis://redis:6379

# ─── Cuenta OWNER del panel (para el seed-owner de producción) ────────────────
OWNER_EMAIL=leonelivanrasjido@gmail.com
OWNER_PASSWORD=CAMBIAR_clave_fuerte_min_10_caracteres

# ─── Secretos internos (GENERAR aleatorios, mínimo 32 caracteres) ─────────────
# Generar con:  openssl rand -base64 48
JWT_ACCESS_SECRET=GENERAR
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECRET=GENERAR

# ─── URLs públicas (deben ser HTTPS en producción) ────────────────────────────
STOREFRONT_URL=https://synory.dev
ADMIN_URL=https://admin.synory.dev
API_PUBLIC_URL=https://api.synory.dev
# Variables que Next hornea en el navegador (build-args):
NEXT_PUBLIC_API_URL=https://api.synory.dev
NEXT_PUBLIC_ADMIN_URL=https://admin.synory.dev
NEXT_PUBLIC_SITE_URL=https://synory.dev

# ─── Correo saliente (SMTP transaccional — ej. Brevo) ─────────────────────────
# Brevo: SMTP & API → SMTP. Host smtp-relay.brevo.com, puerto 587.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Remeras del Área <no-reply@remerasdelarea.com>
# A dónde llegan los avisos de la tienda (podés poner el Gmail de la dueña).
STORE_NOTIFICATION_EMAIL=leonelivanrasjido@gmail.com

# ─── Pasarela de pago (elegir una) ────────────────────────────────────────────
PAYMENT_PROVIDER=uala
# Ualá Bis (producción) — regenerar las credenciales expuestas:
UALA_USERNAME=
UALA_CLIENT_ID=
UALA_CLIENT_SECRET=
UALA_ENV=production
# …o Mercado Pago:
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ─── Notificaciones push (GENERAR con: npx web-push generate-vapid-keys) ──────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:leonelivanrasjido@gmail.com

# ─── Envíos ───────────────────────────────────────────────────────────────────
# Correo Argentino en modo manual (tarifas por provincia en el panel).
SHIPPING_PROVIDER=manual
BALANCE_LINK_TTL_DAYS=14

# ─── Analizador de estilo con IA (opcional) ───────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Marketing (opcional) ─────────────────────────────────────────────────────
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
MERCHANT_FEED_BRAND=Remeras del Área

# ─── Anti-bot Turnstile (opcional; sin claves reales queda deshabilitado) ─────
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
