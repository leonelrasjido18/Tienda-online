# Apps Next (storefront / admin) — imagen de producción. Contexto = raíz del monorepo.
# El build se parametriza con APP (storefront|admin). Los NEXT_PUBLIC_* se hornean
# en el bundle en tiempo de build, así que se pasan como build-args.
# Node 22: jsdom (via isomorphic-dompurify) usa webidl.util.markAsUncloneable, que
# no existe en Node 20 y rompe el `next build` al recolectar páginas.
FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# --- build ---
FROM base AS build
ARG APP
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_ADMIN_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY
ARG NEXT_PUBLIC_META_PIXEL_ID
ARG NEXT_PUBLIC_GA
ARG NEXT_PUBLIC_TIKTOK_PIXEL_ID
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY \
    NEXT_PUBLIC_META_PIXEL_ID=$NEXT_PUBLIC_META_PIXEL_ID \
    NEXT_PUBLIC_GA=$NEXT_PUBLIC_GA \
    NEXT_PUBLIC_TIKTOK_PIXEL_ID=$NEXT_PUBLIC_TIKTOK_PIXEL_ID
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @tienda/shared build
RUN pnpm --filter $APP build

# --- runtime ---
FROM base AS runtime
ARG APP
ENV NODE_ENV=production \
    APP=$APP \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
# El build standalone deja un server.js autocontenido + node_modules trazados.
COPY --from=build /app/apps/${APP}/.next/standalone ./
COPY --from=build /app/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build /app/apps/${APP}/public ./apps/${APP}/public
EXPOSE 3000
CMD ["sh", "-c", "node apps/${APP}/server.js"]
